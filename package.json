{
  "name": "souldew-renaissance",
  "version": "3.0.0-r.1",
  "private": true,
  "description": "souldew Renaissance – a souldew build for big groups: Pokémon SoulLinks and Nuzlockes with a built-in emulator, live sync through its own server and a game library",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/ralandel/souldew",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ralandel/souldew.git"
  },
  "bugs": {
    "url": "https://github.com/ralandel/souldew/issues"
  },
  "funding": "https://buymeacoffee.com/souldew",
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "app": "electron .",
    "test": "node --test --test-timeout=600000 \"test/*.test.mjs\"",
    "lint": "eslint .",
    "jre": "node scripts/fetch-jre.mjs arm64",
    "jre:win": "node scripts/fetch-jre.mjs x64",
    "jre:linux": "node scripts/fetch-jre.mjs x64",
    "ctr": "node scripts/build-ctr.mjs",
    "native": "node scripts/build-native.mjs",
    "dist": "node scripts/check-pinned-keys.mjs && node scripts/fetch-jre.mjs arm64 && node scripts/build-ctr.mjs --check && node scripts/build-native.mjs --check && CUSTOM_DMGBUILD_PATH=scripts/dmgbuild-wrapper.mjs electron-builder --mac dmg --arm64",
    "dist:win": "node scripts/check-pinned-keys.mjs && node scripts/fetch-jre.mjs x64 && node scripts/build-ctr.mjs --check && node scripts/build-native.mjs --check && electron-builder --win nsis --x64",
    "dist:linux": "node scripts/check-pinned-keys.mjs && node scripts/fetch-jre.mjs x64 && node scripts/build-ctr.mjs --check && node scripts/build-native.mjs --check && electron-builder --linux AppImage deb --x64",
    "release": "node scripts/release.mjs",
    "matrix": "node scripts/rom-matrix.mjs --live"
  },
  "updates": {
    "repo": "ralandel/souldew",
    "feed": "https://github.com/{repo}/releases/latest/download/latest.json",
    "publicKey": "MCowBQYDK2VwAyEAUt/HWwEPmR64hSoFVw/w0HX8wtDMfD2cpwkFdMBpKU0="
  },
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "engine.io": "6.6.11",
    "htm": "3.1.1",
    "mqtt": "5.16.1",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "electron": "43.7.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "globals": "14.0.0"
  },
  "main": "electron/main.mjs",
  "desktopName": "souldew-renaissance.desktop",
  "author": "souldew",
  "build": {
    "appId": "com.pkmnrenaissance.souldew",
    "productName": "souldew Renaissance",
    "copyright": "souldew, souldew Renaissance",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "shared/**",
      "web/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!web/emu-test.html",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "tools/upr",
        "to": "tools/upr",
        "filter": [
          "PokeRandoZX.jar",
          "UPR-README.txt"
        ]
      },
      {
        "from": "tools/upr-bridge",
        "to": "tools/upr-bridge",
        "filter": [
          "**/*.class",
          "**/*.java"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSDownloadsFolderUsageDescription": "souldew sucht hier nach deinen Spieldateien (ROMs), wenn du in der Bibliothek „Mac durchsuchen“ wählst. Es werden nur Dateinamen und Datei-Header gelesen – nichts verlässt deinen Mac.",
        "NSDesktopFolderUsageDescription": "souldew sucht hier nach deinen Spieldateien (ROMs), wenn du in der Bibliothek „Mac durchsuchen“ wählst. Es werden nur Dateinamen und Datei-Header gelesen – nichts verlässt deinen Mac.",
        "NSDocumentsFolderUsageDescription": "souldew sucht hier nach deinen Spieldateien (ROMs), wenn du in der Bibliothek „Mac durchsuchen“ wählst. Es werden nur Dateinamen und Datei-Header gelesen – nichts verlässt deinen Mac."
      },
      "extraResources": [
        {
          "from": "tools/jre/darwin-arm64",
          "to": "tools/jre/darwin-arm64"
        },
        {
          "from": "tools/ctr/darwin-arm64",
          "to": "tools/ctr/darwin-arm64"
        },
        {
          "from": "tools/native/darwin-arm64",
          "to": "tools/native/darwin-arm64",
          "filter": [
            "retrohost*",
            "linkhost*",
            "*_libretro.*",
            "SOURCES.txt",
            "LICENSE-*"
          ]
        }
      ],
      "artifactName": "souldew-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "souldew Renaissance",
      "background": "build/background.png",
      "iconSize": 96,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 180,
          "y": 214,
          "type": "file"
        },
        {
          "x": 480,
          "y": 214,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "souldew-${version}-win-${arch}-setup.${ext}",
      "extraResources": [
        {
          "from": "tools/jre/win32-x64",
          "to": "tools/jre/win32-x64"
        },
        {
          "from": "tools/ctr/win32-x64",
          "to": "tools/ctr/win32-x64"
        },
        {
          "from": "tools/native/win32-x64",
          "to": "tools/native/win32-x64",
          "filter": [
            "retrohost*",
            "linkhost*",
            "*_libretro.*",
            "SOURCES.txt",
            "LICENSE-*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "souldew Renaissance",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "souldew Renaissance",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "Pokémon SoulLinks and Nuzlockes with a built-in emulator",
      "description": "souldew Renaissance: Pokémon SoulLinks and solo Nuzlockes with a built-in emulator, live tracking from game memory, randomizer, real-time sync through its own server and OBS overlays.",
      "maintainer": "souldew Renaissance <https://github.com/ralandel/souldew>",
      "vendor": "souldew Renaissance",
      "executableName": "souldew-renaissance",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "souldew-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Keywords": "Pokemon;Pokémon;SoulLink;Nuzlocke;Emulator;Randomizer;"
        }
      },
      "files": [
        "build/icon.png"
      ],
      "extraResources": [
        {
          "from": "tools/jre/linux-x64",
          "to": "tools/jre/linux-x64"
        },
        {
          "from": "tools/ctr/linux-x64",
          "to": "tools/ctr/linux-x64"
        },
        {
          "from": "tools/native/linux-x64",
          "to": "tools/native/linux-x64",
          "filter": [
            "retrohost*",
            "linkhost*",
            "*_libretro.*",
            "SOURCES.txt",
            "LICENSE-*"
          ]
        }
      ]
    },
    "publish": null
  },
  "volta": {
    "node": "22.17.0"
  }
}
