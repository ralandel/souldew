<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- souldew.app with the hardened runtime (Developer ID, notarized – scripts/dist-mac-signed.mjs).
     Electron's JavaScript engine compiles code at run time: JIT and executable memory. Library validation stays off for
     Electron's own frameworks and helpers (electron-builder's defaults). No sandbox, no camera, no microphone. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
