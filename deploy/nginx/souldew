# /etc/nginx/sites-available/souldew – souldew Renaissance (deploy/README.md). Its own server_name only: the API's
# site (renaissance-api) is never touched. certbot --nginx added the TLS lines and the http → https redirect.
server {
    server_name souldew.pkmnrenaissance.com;

    # MQTT broker (Mosquitto, WebSocket listener)
    location = /mqtt {
        proxy_pass http://127.0.0.1:9001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Nostr relay for WebRTC signalling (deploy/nostr)
    location = /nostr {
        proxy_pass http://127.0.0.1:7777/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / { return 404; }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/souldew.pkmnrenaissance.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/souldew.pkmnrenaissance.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = souldew.pkmnrenaissance.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name souldew.pkmnrenaissance.com;
    return 404; # managed by Certbot
}
